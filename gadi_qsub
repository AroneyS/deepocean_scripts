#!/usr/bin/env python3
import os
import re
import sys
import argparse
import subprocess

from snakemake.utils import read_job_properties

# See https://github.com/Snakemake-Profiles/pbs-torque

# GPU jobs (e.g. Aviary's taxvamb/semibin/comebin binners run with --request-gpu,
# which set the snakemake rule's `resources: gpus = N`) are routed to gpuvolta
# instead of whatever queue the profile passes via -q. NCI's gpuvolta queue is
# allocated in fixed units of 12 cpus + ~95GB mem per GPU, so ncpus/mem are
# overridden to that ratio rather than trusting the rule's CPU-mode thread/mem
# request.
GPU_QUEUE = "gpuvolta"
CPUS_PER_GPU = 12
MEM_GB_PER_GPU = 95

# High-memory jobs (e.g. Aviary's prepare_binning_files_split, which requests the
# full --aviary-recover-memory budget -- 250GB by default -- independently per
# split, not divided among them) can exceed the `normal` queue's per-node memory
# ceiling. Confirmed empirically on Gadi: `qsub -l mem=192GB -q normal` succeeds,
# `qsub -l mem=256GB -q normal` fails with "Error: You have requested more memory
# per node (256.0GB) than the nodes in queue normal can provide." Route jobs
# requesting more than NORMAL_QUEUE_MAX_MEM_GB to hugemem instead, same pattern as
# the GPU routing above.
NORMAL_QUEUE_MAX_MEM_GB = 192
HUGEMEM_QUEUE = "hugemem"

# Project zh61's walltime allocation on Gadi caps every queue (confirmed
# empirically: normal, hugemem, AND gpuvolta all reject the same request with
# "Requested walltime is longer than allowed for project 'zh61'. Maximum walltime
# for job requesting N CPUs in <queue> queue is 48.0 hours.", independent of ncpus
# too -- tested 4/8/16/32) at 48h, regardless of what a rule's own resources.runtime
# lambda computes (e.g. Aviary's refine_rosella/refine_metabat2/refine_semibin
# request 48h + 24h*attempt = 72h on attempt 1 alone). Unlike the memory case,
# there's no bigger queue to escalate to -- 48h is the ceiling full stop (the error
# itself says to email help@nci.org.au to raise it) -- so just cap whatever's
# requested rather than let the submission fail outright. If a job genuinely needs
# longer than 48h to finish, it'll get walltime-killed by PBS and need a
# resubmit/resume; that's a real limitation of the current project allocation, not
# something a client-side qsub trick can work around.
PROJECT_MAX_WALLTIME_HOURS = 48

# Per-rule floors for resources the snakemake profile requests globally, or that
# aviary hardcodes too low. Both are raised only for the named rules so the
# profile-wide defaults (deliberately modest, on NCI's advice, because
# over-requesting delays scheduling) stay untouched for everything else.
#
# jobfs: measured across all 29 rules and ~600 completed jobs, exactly one rule
# uses non-trivial node-local scratch -- prepare_binning_files_split peaked at
# 65.4GB over 121 runs (that peak IS the run PBS killed at the 60GB request), while
# every other rule stayed at or below 1.9GB. It is the coverm mapping/BAM-sort step,
# so its temp usage scales with the read volume of the coassembly's split; 200GB
# gives ~3x headroom over the observed peak for the larger coassemblies still to
# run, and still asks for half of the old profile-wide 400GB.
RULE_MIN_JOBFS_GB = {
    "prepare_binning_files_split": 150,
}
# walltime: aviary hardcodes `runtime = 24*60*attempt` for comebin, and under
# --immediate-submit snakemake's retries never fire (that is also why the memory
# tiering lives in manage_recover.py rather than relying on attempt escalation), so
# attempt is permanently 1 and comebin can never get more than 24h -- despite
# observed runs finishing just over that (24:02 walltime, 81 CPU-hours). There is no
# aviary CLI/config knob for it, so floor it here instead. Still bounded by
# PROJECT_MAX_WALLTIME_HOURS below, so this cannot request more than the project
# allows.
RULE_MIN_WALLTIME_HOURS = {
    "comebin": 48,
}


def apply_rule_jobfs(resource_arg, rule):
    """Raise a `-l ...jobfs=NGB...` request to this rule's floor, if it has one.

    Rewrites rather than appends: PBS takes the last value for a repeated resource,
    and leaving two conflicting jobfs= entries in one -l string is ambiguous.
    """
    need = RULE_MIN_JOBFS_GB.get(rule)
    if not need or not resource_arg:
        return resource_arg

    def repl(m):
        value, unit = float(m.group(1)), m.group(2).upper()
        gb = {"K": value / 1048576, "M": value / 1024, "G": value, "T": value * 1024}[unit]
        return f"jobfs={need}GB" if gb < need else m.group(0)

    return re.sub(r"jobfs=([0-9.]+)([KMGT])B?", repl, resource_arg, flags=re.IGNORECASE)

# pixi/envs/* directories were blowing up the zh61 project's gadi-scratch1 *inode*
# quota (NCI explicitly discourages conda-style environments on Gadi for exactly
# this reason -- many small files). Fixed by squashing each top-level pixi/envs/*
# directory into one .sqfs image (one inode instead of the ~1.1M files they held
# combined -- aviary-13890928915679139205 alone was 874K), leaving an EMPTY
# placeholder directory at each original path. Nothing in those directories is
# readable anymore unless bind-mounted back via apptainer, so every submitted job
# now runs through an apptainer-exec wrapper that mounts all 5 images at their
# original paths before invoking the real jobscript -- transparent to whatever
# `pixi run --manifest-path ... -e <env> ...` the jobscript itself calls, since
# each env resolves to its normal absolute path either way. Verified end-to-end
# (rigorous negative-control tests -- empty placeholder + bind + read + confirm
# host stays empty after -- for every image, plus a real PBS job running `pixi run
# -e checkm2 checkm2 --help` through all 5 binds simultaneously) before wiring in.
APPTAINER_BIN = "/opt/nci/apptainer/bin/apptainer"
APPTAINER_BASE_SIF = "/home/586/sa4958/deepocean_scripts/sqfs_base/ubuntu.sif"
PIXI_SQFS_DIR = "/scratch/zh61/sa4958/pixi/sqfs"
PIXI_ENVS_DIR = "/scratch/zh61/sa4958/pixi/envs"
PIXI_SQFS_ENVS = [
    "aviary-13890928915679139205",
    "binchicken-16235779617320621780",
    "DeepOceanGenomes-9637173285384759191",
    "BinChicken-5222337612630778772",
    "assembly_checkpointing-2012764050369663368",
]

# The apptainer base image (ubuntu:22.04) ships Debian's shell-script `which`,
# incompatible with the GNU `which` flags Gadi's own Rocky Linux 8 base provides
# -- broke aviary's coverm rule (bird_tool_utils's external_command_checker calls
# `which minimap2` and choked on Ubuntu's `which` with "Illegal option --",
# reported as "Could not find an available minimap2 executable" even though
# minimap2 was present and correctly on PATH). Fixed by bind-mounting Gadi's own
# `which` binary in over the container's -- NOT the whole /usr (tried that first:
# it collided with the container's own glibc/dynamic-linker resolution and broke
# pixi's own virtual-package detection). `/usr/bin/which` on Gadi is itself a
# symlink into NCI's `/half-root` overlay; bind the fully-resolved real file
# so the container doesn't have to re-resolve a symlink chain that only makes
# sense in the host's own mount namespace.
GADI_WHICH_BIN = "/half-root/usr/bin/which"


def make_apptainer_wrapper(jobscript):
    """Write a small wrapper next to `jobscript` that apptainer-execs it with all
    5 pixi env squashfs images bind-mounted at their original paths, and return
    the wrapper's path. The original jobscript's own content/logic is untouched --
    only what gets submitted to qsub changes.
    """
    binds = " ".join(
        f"--bind {PIXI_SQFS_DIR}/{name}.sqfs:{PIXI_ENVS_DIR}/{name}:image-src=/"
        for name in PIXI_SQFS_ENVS
    )
    wrapper_path = jobscript + ".apptainer_wrap.sh"
    with open(wrapper_path, "w") as f:
        f.write(f"""#!/bin/bash
set -euo pipefail
exec "{APPTAINER_BIN}" exec {binds} \\
    --bind "$HOME:$HOME" --bind /etc/ssl:/etc/ssl --bind /etc/pki:/etc/pki \\
    --bind "{GADI_WHICH_BIN}:/usr/bin/which" \\
    --bind "$PWD:$PWD" --pwd "$PWD" \\
    "{APPTAINER_BASE_SIF}" env PATH="$PATH" bash "{jobscript}"
""")
    os.chmod(wrapper_path, 0o755)
    return wrapper_path


parser=argparse.ArgumentParser(add_help=False)
parser.add_argument("--depend", help="Space separated list of ids for jobs this job should depend on.")
parser.add_argument("-a", help="Declare the time when the job becomes eligible for execution.")
parser.add_argument("-A", help="Define the account string.")
parser.add_argument("-b", help="PBS Server timeout.")
parser.add_argument("-c", help="Checkpoint options.")
parser.add_argument("-C", help="Directive prefix in script file.")
parser.add_argument("-d", help="Working directory to be used (default: ~). PBS_O_INITDIR")
parser.add_argument("-D", help="Root directory to be used. PBS_O_ROOTDIR")
parser.add_argument("-e", help="standard error path.")
parser.add_argument("-f", help="Fault tolerant.",action="store_true")
parser.add_argument("-h", help="Apply user hold at submission time",action="store_true")
parser.add_argument("-j", help="Merge standard error and standard out. (oe or eo)")
parser.add_argument("-l", help="Resource list.")
parser.add_argument("-m", help="Mail options.")
parser.add_argument("-M", help="Mail users.")
parser.add_argument("-N", help="Name for the job.")
parser.add_argument("-o", help="standard output path.")
parser.add_argument("-p", help="Set job priority.")
parser.add_argument("-P", help="Proxy user for job.")
parser.add_argument("-q", help="Set destination queue.")
parser.add_argument("-t", help="Array request.")
parser.add_argument("-u", help="Set user name for job.")
parser.add_argument("-v", help="Environment variables to export to the job.")
parser.add_argument("-V", help="Export all environment variables.",action="store_true")
parser.add_argument("-w", help="Set working directory. PBS_O_WORKDIR")
parser.add_argument("-W", help="Additional attributes.")
parser.add_argument("--help", help="Display help message.",action="store_true")

parser.add_argument("positional",action="append",nargs="?")
args = parser.parse_args()

if args.help :
    parser.print_help()
    sys.exit(0)

jobscript = sys.argv[-1]

job_properties = read_job_properties(jobscript)

atime=""
acc_string=""
pbs_time=""
chkpt=""
pref=""
dd=""
rd=""
se=""
ft=""
hold=""
j=""
resource=""
mail=""
mailuser=""
jname=""
so=""
priority=""
proxy=""
q=""
ar=""
user=""
ev=""
eall=""
wd=""
add=""
depend=""
resourceparams=""
extras=""


if args.depend:
	for m in args.depend.split(" "):
		depend = depend + ":" + m
if depend:
	depend = " -W \"depend=afterok" + depend + "\""

if args.positional:
	positional = list(args.positional)
	positional[-1] = make_apptainer_wrapper(positional[-1])
	for m in positional:
		extras = extras + " " + m

if args.a: atime = " -a " + args.a
if args.A: acc_string = " -P " + args.A
if args.b: pbs_time = " -b " + args.b
if args.c: chkpt = " -c " + args.c
if args.C: pref = " -C " + args.C
if args.d: dd = " -d " + args.d
if args.D: rd = " -D " + args.D
if args.e: se = " -e " + args.e
if args.f: ft = " -f"
if args.h: hold = " -h"
if args.j: j = " -j " + args.j
if args.l: resource = " -l " + apply_rule_jobfs(args.l, job_properties.get("rule", ""))
if args.m: mail = " -m " + args.m
if args.M: mailuser = " -M " + args.M
if args.N: jname = " -N " + args.N
if args.o: so = " -o " + args.o
if args.p: priority = " -p " + args.p
if args.P: proxy = " -P " + args.P
if args.q: q = " -q " + args.q
if args.t: ar = " -t " + args.ar
if args.u: user = " -u " + args.u
if args.v: ev = " -v " + args.v
if args.V: eall = " -V"
if args.w: wd = " -w " + args.w
if args.W: add= " -W \"" + args.W + "\""

ncpus=""
mem=""
walltime=""
gpus=0

if "resources" in job_properties:
    resources = job_properties["resources"]
    gpus = int(resources.get("gpus", 0) or 0)

if gpus > 0:
    q = " -q " + GPU_QUEUE
    ncpus = "ncpus=" + str(CPUS_PER_GPU * gpus)
    mem = "mem=" + str(MEM_GB_PER_GPU * gpus) + "GB"
    ngpus = "ngpus=" + str(gpus)
else:
    ngpus = ""
    if "threads" in job_properties:
        ncpus = "ncpus=" + str(job_properties["threads"])
    if "resources" in job_properties:
        resources = job_properties["resources"]
        if "mem_mb" in resources:
            provided_mem = resources["mem_mb"]
            if provided_mem == "<TBD>":
                mem=""
            else:
                mem_mb_value = int(provided_mem)
                mem="mem=" + str(mem_mb_value) + "MB"
                if mem_mb_value > NORMAL_QUEUE_MAX_MEM_GB * 1024:
                    q = " -q " + HUGEMEM_QUEUE

if "resources" in job_properties:
    resources = job_properties["resources"]
    if "runtime" in resources:
        # Floor first (aviary underestimates some rules), then the project cap.
        requested = int(resources["runtime"]) * 60
        floor = RULE_MIN_WALLTIME_HOURS.get(job_properties.get("rule", ""), 0) * 3600
        walltime_seconds = min(max(requested, floor), PROJECT_MAX_WALLTIME_HOURS * 3600)
        walltime = "walltime=" + str(walltime_seconds)
    else:
        walltime="walltime=48:00:00"

resourceparts = [p for p in [ncpus, ngpus, mem, walltime] if p]
if resourceparts: resourceparams = " -l \"" + ",".join(resourceparts) + "\""

if "cluster" in job_properties:
    cluster = job_properties["cluster"]
    if "error" in cluster:
        os.makedirs(os.path.dirname(cluster["error"]), exist_ok=True)
        se = " -e " + cluster["error"]
    if "output" in cluster:
        os.makedirs(os.path.dirname(cluster["output"]), exist_ok=True)
        so = " -o " + cluster["output"]

cmd = "qsub {a}{A}{b}{c}{C}{d}{D}{e}{f}{h}{j}{l}{m}{M}{N}{o}{p}{P}{q}{t}{u}{v}{V}{w}{W}{rp}{dep}{ex}".format(\
	a=atime,A=acc_string,b=pbs_time,c=chkpt,C=pref,d=dd,D=rd,e=se,f=ft,h=hold,j=j,l=resource,m=mail,M=mailuser,\
	N=jname,o=so,p=priority,P=proxy,q=q,t=ar,u=user,v=ev,V=eall,w=wd,W=add,rp=resourceparams,dep=depend,ex=extras)

try:
    res = subprocess.run(cmd, check=True, shell=True, stdout=subprocess.PIPE)
except subprocess.CalledProcessError as e:
    raise e

res = res.stdout.decode()
print(res.strip())
