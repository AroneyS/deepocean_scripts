]

# The apptainer base image (ubuntu:22.04) ships Debian's shell-script `which`,
# incompatible with the GNU `which` flags Gadi's own Rocky Linux 8 base provides
# -- broke aviary's coverm rule (bird_tool_utils's external_command_checker calls
# `which minimap2` and choked on Ubuntu's `which` with "Illegal option --",
# reported as "Could not find an available minimap2 executable" even though
# minimap2 was present and correctly on PATH). Fixed by bind-mounting Gadi's own
# `which` binary in over the container's -- NOT the whole /usr (tried that first:
# it collided with the container's own glibc/dynamic-linker resolution and broke
# pixi's own virtual-package detection). `/usr/bin/which` on Gadi is itself a
# symlink into NCI's `/half-root` overlay; bind the fully-resolved real file
# so the container doesn't have to re-resolve a symlink chain that only makes
# sense in the host's own mount namespace.
# Every pixi env here is bind-mounted from a read-only squashfs image, including the
# one holding aviary's own nested project manifest
# (binchicken-<hash>/envs/aviary/.../site-packages/aviary/pixi.toml). Aviary's rules
# shell out to `pixi run --manifest-path <that> -e <env>`, and pixi will rewrite the
# lock file beside the manifest whenever it considers it stale -- which fails on a
# read-only mount with "failed to write lock file to disk / Read-only file system
# (os error 30)". That killed every coassembly at filter_contigs_by_size (the second
# rule) on 2026-09-20: 314 identical failures, no coassembly ever reached mapping.
# It only began after pixi was upgraded to 0.78.0 and aviary to 0.13.3 -- the same
# read-only mounts worked before, so it is pixi deciding the existing lock needs
# migrating, not a missing lock (both old and new images ship one).
#
# PIXI_FROZEN=true makes pixi use the lock as-is and never write it. Set here rather
# than in aviary (whose pixi_run string we do not control) or per-rule, so it covers
# every pixi invocation any rule makes inside the container. Verified by running the
# exact failing seqkit command under the real bind set with and without it.
GADI_WHICH_BIN = "/half-root/usr/bin/which"


def make_apptainer_wrapper(jobscript):
    """Write a small wrapper next to `jobscript` that apptainer-execs it with all
    5 pixi env squashfs images bind-mounted at their original paths, and return
    the wrapper's path. The original jobscript's own content/logic is untouched --
    only what gets submitted to qsub changes.
    """
    binds = " ".join(
        f"--bind {PIXI_SQFS_DIR}/{name}.sqfs:{PIXI_ENVS_DIR}/{name}:image-src=/"
        for name in PIXI_SQFS_ENVS
    )
    wrapper_path = jobscript + ".apptainer_wrap.sh"
    with open(wrapper_path, "w") as f:
        f.write(f"""#!/bin/bash
set -euo pipefail
exec "{APPTAINER_BIN}" exec {binds} \\
    --bind "$HOME:$HOME" --bind /etc/ssl:/etc/ssl --bind /etc/pki:/etc/pki \\
    --bind "{GADI_WHICH_BIN}:/usr/bin/which" \\
    --bind "$PWD:$PWD" --pwd "$PWD" \\
    "{APPTAINER_BASE_SIF}" env PATH="$PATH" PIXI_FROZEN=true bash "{jobscript}"
""")
    os.chmod(wrapper_path, 0o755)
    return wrapper_path


