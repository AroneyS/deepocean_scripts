#!/usr/bin/env python3
import os
import sys
import argparse
import subprocess

from snakemake.utils import read_job_properties

# See https://github.com/Snakemake-Profiles/pbs-torque

# GPU jobs (e.g. Aviary's taxvamb/semibin/comebin binners run with --request-gpu,
# which set the snakemake rule's `resources: gpus = N`) are routed to gpuvolta
# instead of whatever queue the profile passes via -q. NCI's gpuvolta queue is
# allocated in fixed units of 12 cpus + ~95GB mem per GPU, so ncpus/mem are
# overridden to that ratio rather than trusting the rule's CPU-mode thread/mem
# request.
GPU_QUEUE = "gpuvolta"
CPUS_PER_GPU = 12
MEM_GB_PER_GPU = 95

# High-memory jobs (e.g. Aviary's prepare_binning_files_split, which requests the
# full --aviary-recover-memory budget -- 250GB by default -- independently per
# split, not divided among them) can exceed the `normal` queue's per-node memory
# ceiling. Confirmed empirically on Gadi: `qsub -l mem=192GB -q normal` succeeds,
# `qsub -l mem=256GB -q normal` fails with "Error: You have requested more memory
# per node (256.0GB) than the nodes in queue normal can provide." Route jobs
# requesting more than NORMAL_QUEUE_MAX_MEM_GB to hugemem instead, same pattern as
# the GPU routing above.
NORMAL_QUEUE_MAX_MEM_GB = 192
HUGEMEM_QUEUE = "hugemem"

# Project zh61's walltime allocation on Gadi caps every queue (confirmed
# empirically: normal, hugemem, AND gpuvolta all reject the same request with
# "Requested walltime is longer than allowed for project 'zh61'. Maximum walltime
# for job requesting N CPUs in <queue> queue is 48.0 hours.", independent of ncpus
# too -- tested 4/8/16/32) at 48h, regardless of what a rule's own resources.runtime
# lambda computes (e.g. Aviary's refine_rosella/refine_metabat2/refine_semibin
# request 48h + 24h*attempt = 72h on attempt 1 alone). Unlike the memory case,
# there's no bigger queue to escalate to -- 48h is the ceiling full stop (the error
# itself says to email help@nci.org.au to raise it) -- so just cap whatever's
# requested rather than let the submission fail outright. If a job genuinely needs
# longer than 48h to finish, it'll get walltime-killed by PBS and need a
# resubmit/resume; that's a real limitation of the current project allocation, not
# something a client-side qsub trick can work around.
PROJECT_MAX_WALLTIME_HOURS = 48

parser=argparse.ArgumentParser(add_help=False)
parser.add_argument("--depend", help="Space separated list of ids for jobs this job should depend on.")
parser.add_argument("-a", help="Declare the time when the job becomes eligible for execution.")
parser.add_argument("-A", help="Define the account string.")
parser.add_argument("-b", help="PBS Server timeout.")
parser.add_argument("-c", help="Checkpoint options.")
parser.add_argument("-C", help="Directive prefix in script file.")
parser.add_argument("-d", help="Working directory to be used (default: ~). PBS_O_INITDIR")
parser.add_argument("-D", help="Root directory to be used. PBS_O_ROOTDIR")
parser.add_argument("-e", help="standard error path.")
parser.add_argument("-f", help="Fault tolerant.",action="store_true")
parser.add_argument("-h", help="Apply user hold at submission time",action="store_true")
parser.add_argument("-j", help="Merge standard error and standard out. (oe or eo)")
parser.add_argument("-l", help="Resource list.")
parser.add_argument("-m", help="Mail options.")
parser.add_argument("-M", help="Mail users.")
parser.add_argument("-N", help="Name for the job.")
parser.add_argument("-o", help="standard output path.")
parser.add_argument("-p", help="Set job priority.")
parser.add_argument("-P", help="Proxy user for job.")
parser.add_argument("-q", help="Set destination queue.")
parser.add_argument("-t", help="Array request.")
parser.add_argument("-u", help="Set user name for job.")
parser.add_argument("-v", help="Environment variables to export to the job.")
parser.add_argument("-V", help="Export all environment variables.",action="store_true")
parser.add_argument("-w", help="Set working directory. PBS_O_WORKDIR")
parser.add_argument("-W", help="Additional attributes.")
parser.add_argument("--help", help="Display help message.",action="store_true")

parser.add_argument("positional",action="append",nargs="?")
args = parser.parse_args()

if args.help :
    parser.print_help()
    sys.exit(0)

jobscript = sys.argv[-1]

job_properties = read_job_properties(jobscript)

atime=""
acc_string=""
pbs_time=""
chkpt=""
pref=""
dd=""
rd=""
se=""
ft=""
hold=""
j=""
resource=""
mail=""
mailuser=""
jname=""
so=""
priority=""
proxy=""
q=""
ar=""
user=""
ev=""
eall=""
wd=""
add=""
depend=""
resourceparams=""
extras=""


if args.depend:
	for m in args.depend.split(" "):
		depend = depend + ":" + m
if depend:
	depend = " -W \"depend=afterok" + depend + "\""

if args.positional:
	for m in args.positional:
		extras = extras + " " + m

if args.a: atime = " -a " + args.a
if args.A: acc_string = " -P " + args.A
if args.b: pbs_time = " -b " + args.b
if args.c: chkpt = " -c " + args.c
if args.C: pref = " -C " + args.C
if args.d: dd = " -d " + args.d
if args.D: rd = " -D " + args.D
if args.e: se = " -e " + args.e
if args.f: ft = " -f"
if args.h: hold = " -h"
if args.j: j = " -j " + args.j
if args.l: resource = " -l " + args.l
if args.m: mail = " -m " + args.m
if args.M: mailuser = " -M " + args.M
if args.N: jname = " -N " + args.N
if args.o: so = " -o " + args.o
if args.p: priority = " -p " + args.p
if args.P: proxy = " -P " + args.P
if args.q: q = " -q " + args.q
if args.t: ar = " -t " + args.ar
if args.u: user = " -u " + args.u
if args.v: ev = " -v " + args.v
if args.V: eall = " -V"
if args.w: wd = " -w " + args.w
if args.W: add= " -W \"" + args.W + "\""

ncpus=""
mem=""
walltime=""
gpus=0

if "resources" in job_properties:
    resources = job_properties["resources"]
    gpus = int(resources.get("gpus", 0) or 0)

if gpus > 0:
    q = " -q " + GPU_QUEUE
    ncpus = "ncpus=" + str(CPUS_PER_GPU * gpus)
    mem = "mem=" + str(MEM_GB_PER_GPU * gpus) + "GB"
    ngpus = "ngpus=" + str(gpus)
else:
    ngpus = ""
    if "threads" in job_properties:
        ncpus = "ncpus=" + str(job_properties["threads"])
    if "resources" in job_properties:
        resources = job_properties["resources"]
        if "mem_mb" in resources:
            provided_mem = resources["mem_mb"]
            if provided_mem == "<TBD>":
                mem=""
            else:
                mem_mb_value = int(provided_mem)
                mem="mem=" + str(mem_mb_value) + "MB"
                if mem_mb_value > NORMAL_QUEUE_MAX_MEM_GB * 1024:
                    q = " -q " + HUGEMEM_QUEUE

if "resources" in job_properties:
    resources = job_properties["resources"]
    if "runtime" in resources:
        walltime_seconds = min(int(resources["runtime"]) * 60, PROJECT_MAX_WALLTIME_HOURS * 3600)
        walltime = "walltime=" + str(walltime_seconds)
    else:
        walltime="walltime=48:00:00"

resourceparts = [p for p in [ncpus, ngpus, mem, walltime] if p]
if resourceparts: resourceparams = " -l \"" + ",".join(resourceparts) + "\""

if "cluster" in job_properties:
    cluster = job_properties["cluster"]
    if "error" in cluster:
        os.makedirs(os.path.dirname(cluster["error"]), exist_ok=True)
        se = " -e " + cluster["error"]
    if "output" in cluster:
        os.makedirs(os.path.dirname(cluster["output"]), exist_ok=True)
        so = " -o " + cluster["output"]

cmd = "qsub {a}{A}{b}{c}{C}{d}{D}{e}{f}{h}{j}{l}{m}{M}{N}{o}{p}{P}{q}{t}{u}{v}{V}{w}{W}{rp}{dep}{ex}".format(\
	a=atime,A=acc_string,b=pbs_time,c=chkpt,C=pref,d=dd,D=rd,e=se,f=ft,h=hold,j=j,l=resource,m=mail,M=mailuser,\
	N=jname,o=so,p=priority,P=proxy,q=q,t=ar,u=user,v=ev,V=eall,w=wd,W=add,rp=resourceparams,dep=depend,ex=extras)

try:
    res = subprocess.run(cmd, check=True, shell=True, stdout=subprocess.PIPE)
except subprocess.CalledProcessError as e:
    raise e

res = res.stdout.decode()
print(res.strip())
