MEM_GB_PER_GPU = 95

# High-memory jobs (e.g. Aviary's prepare_binning_files_split, which requests the
# full --aviary-recover-memory budget -- 250GB by default -- independently per
# split, not divided among them) can exceed the `normal` queue's per-node memory
# ceiling. Confirmed empirically on Gadi: `qsub -l mem=192GB -q normal` succeeds,
# `qsub -l mem=256GB -q normal` fails with "Error: You have requested more memory
# per node (256.0GB) than the nodes in queue normal can provide." Route jobs
# requesting more than NORMAL_QUEUE_MAX_MEM_GB to hugemem instead, same pattern as
# the GPU routing above.
NORMAL_QUEUE_MAX_MEM_GB = 192
HUGEMEM_QUEUE = "hugemem"

# Project zh61's walltime allocation on Gadi caps every queue (confirmed
# empirically: normal, hugemem, AND gpuvolta all reject the same request with
# "Requested walltime is longer than allowed for project 'zh61'. Maximum walltime
# for job requesting N CPUs in <queue> queue is 48.0 hours.", independent of ncpus
# too -- tested 4/8/16/32) at 48h, regardless of what a rule's own resources.runtime
# lambda computes (e.g. Aviary's refine_rosella/refine_metabat2/refine_semibin
# request 48h + 24h*attempt = 72h on attempt 1 alone). Unlike the memory case,
# there's no bigger queue to escalate to -- 48h is the ceiling full stop (the error
# itself says to email help@nci.org.au to raise it) -- so just cap whatever's
# requested rather than let the submission fail outright. If a job genuinely needs
# longer than 48h to finish, it'll get walltime-killed by PBS and need a
# resubmit/resume; that's a real limitation of the current project allocation, not
# something a client-side qsub trick can work around.
# Memory to request when snakemake reports mem_mb as "<TBD>" at submission time.
#
# A rule that declares no mem_mb of its own inherits snakemake's built-in default,
# 2*input.size_mb -- which cannot be evaluated when the job is submitted, because
# --immediate-submit queues the whole DAG before any earlier rule has produced that
# input. Snakemake therefore sends "<TBD>", and this used to become mem="" -- no mem in
# the -l string at all, so PBS applied its own 500MB default. Any such rule needing more
# than 500MB was then SIGKILLed the moment it ran: observed 2026-09-21 on
# filter_contigs_by_size, which resolved to mem_mb=4540 at execution (2 x a 2.21GB
# assembly) against the 500MB it had actually been given, taking ~30 afterok dependants
# down with it and emailing about each.
#
# 8GB is deliberately a single global number rather than a per-rule table: no mem_mb
# expression anywhere in aviary references `input`, so every rule that sets its own
# mem_mb computes it from config/attempt alone and resolves fine at submit time --
# "<TBD>" only ever reaches here from rules that declare nothing. In binning.smk that is
# just filter_contigs_by_size, semibin_multi_prepare and vamb_skip, and the largest
# assembly in this project is 3.48GB, so the biggest 2*input this can ever mean is 7.0GB.
# Real usage is far lower (seqkit streams; the rest is snakemake's own ~0.5GB), so this
# is a ceiling that costs nothing in scheduling terms.
TBD_FALLBACK_MEM_MB = 8 * 1024

PROJECT_MAX_WALLTIME_HOURS = 48

# Per-rule walltime CEILINGS, applied on top of the project-wide cap above (contrast
# RULE_MIN_JOBFS_GB below, which raises floors). Only for rules whose failure mode is a
# non-converging hang rather than honest slowness: for those a rule's own
# resources.runtime is a request for the worst case, and honouring it just means paying
# the full 48h before the manager can see the stall and stop asking for that binner.
# quickbin has never completed a coassembly in this project (3 runs, all killed, after
# 0.25-17.8h, ~2,880 SU) while requesting the full 48h, so cap it low enough that a hang
# is cheap and surfaces as a -29 promptly. Keep in step with manage_recover.py's
# HANG_PRONE_BINNERS, which is what acts on that -29: a cap here with no entry there
# truncates the binner on every attempt instead of giving up on it.
# Ceilings below are 4x the MAXIMUM walltime observed over the ~2,400 successful jobs in
# results/recover/20260813/resource_usage.tsv, rounded up to a sane step. They exist
# because NCI's priority calculation sums each queued job's POTENTIAL allocation
# (walltime x ncpus) at its full request -- and counts afterok-HELD jobs too. With ~557
# jobs per in-flight batch, nearly all inheriting the profile's 24-48h default, that sum
# reached 1,828,848 cpu-hours against 50,098 actually used (36.5x), which NCI confirmed
# (2026-09-22) tipped the formula into a pathological case: zh61 jobs sat at Priority 0
# with "under job_sort_formula threshold value" for ~30h until staff intervened manually.
# Their advice was to shrink the number of jobs in dependency chains, or make the
# allocation requests accurate. This table does the latter: it takes the counted total to
# 686,342 cpu-hours (2.7x reduction) while still leaving 4x headroom on every rule.
#
# Deliberately ABSENT, so they keep their own (accurate) requests:
#   prepare_binning_files_split -- 32.96h observed against a 48h request
#   rosella                     -- 16.67h observed against a 24h request
# Those two dominate what remains, which is why the reduction is 2.7x and not 30x.
#
# CAUTION when editing: unlike the memory floor above, too LOW a value here is actively
# destructive -- the job is walltime-killed (-29), and under --immediate-submit PBS then
# terminates every afterok dependant, turning one bad ceiling into a stalled coassembly
# plus a flood of abort emails. Raise on suspicion, never trim to fit.
#
# These numbers come from aviary 0.13.2 / minimap2-sr / coverm 0.7.0. This project now
# runs 0.13.3 with strobealign and coverm 0.8.0, so anything mapping-adjacent may shift;
# revisit once the current run has produced its own resource_usage.tsv. quickbin's 6 is
# not measurement-derived at all -- it has never succeeded here, so it is a deliberate
# budget (see manage_recover.py's HANG_PRONE_BINNERS).
#
# 2026-09-25 revision, against results/recover/20260918/resource_usage.tsv (aviary 0.13.3 /
# strobealign / coverm 0.8.0): every cap verified to retain >=2x headroom except the metabat
# family, whose runtimes rose sharply on the new stack -- metabat_sspec went 0.37h -> 1.57h,
# leaving only 1.3x against its 2h cap. sspec raised 2 -> 4 and sens/ssens/spec 4 -> 6.
# Note prepare_binning_files_split got FASTER (32.96h -> 1.37h max), so the decision to
# leave it uncapped costs nothing; revisit capping it once more coassemblies finish.
# comebin's 12 is a deliberate exception to the 4x-of-observed-max rule this table
# otherwise follows. Across 31 successful runs on the current stack it never exceeded
# 6.51h (median 3.11h), so 4x would be ~26h -- but its failure mode is hanging, not
# running long, and its walltime kills were burning the full 24.03h before being dropped
# by manage_recover.py's HANG_PRONE_BINNERS. 12h keeps ~1.8x headroom over the worst
# real run while cutting the cost of each hang by ~2x. The tradeoff is explicit: a
# genuinely slow comebin needing >12h is killed and dropped rather than finished, which
# is acceptable because it is an opt-in extra binner whose output is not required.
