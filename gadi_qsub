# Per-rule floors for resources the snakemake profile requests globally, or that
# aviary hardcodes too low. Both are raised only for the named rules so the
# profile-wide defaults (deliberately modest, on NCI's advice, because
# over-requesting delays scheduling) stay untouched for everything else.
#
# jobfs: measured across all 29 rules and ~600 completed jobs, exactly one rule
# uses non-trivial node-local scratch -- prepare_binning_files_split peaked at
# 65.4GB over 121 runs (that peak IS the run PBS killed at the 60GB request), while
# every other rule stayed at or below 1.9GB. It is the coverm mapping/BAM-sort step,
# so its temp usage scales with the read volume of the coassembly's split. 150GB is
# ~2.3x the observed peak, chosen over 100GB because scaling that peak to the
# largest coassembly still to run (770GiB of reads vs 471GiB) projects ~107GB, and
# over-requesting costs only some scheduling flexibility whereas under-requesting
# costs a SIGTERM plus the whole downstream afterok chain.
RULE_MIN_JOBFS_GB = {
    "prepare_binning_files_split": 150,
}
def apply_rule_jobfs(resource_arg, rule):
    """Raise a `-l ...jobfs=NGB...` request to this rule's floor, if it has one.

    Rewrites rather than appends: PBS takes the last value for a repeated resource,
    and leaving two conflicting jobfs= entries in one -l string is ambiguous.
    """
    need = RULE_MIN_JOBFS_GB.get(rule)
    if not need or not resource_arg:
        return resource_arg

    def repl(m):
        value, unit = float(m.group(1)), m.group(2).upper()
        gb = {"K": value / 1048576, "M": value / 1024, "G": value, "T": value * 1024}[unit]
        return f"jobfs={need}GB" if gb < need else m.group(0)

    return re.sub(r"jobfs=([0-9.]+)([KMGT])B?", repl, resource_arg, flags=re.IGNORECASE)

# pixi/envs/* directories were blowing up the zh61 project's gadi-scratch1 *inode*
# quota (NCI explicitly discourages conda-style environments on Gadi for exactly
# this reason -- many small files). Fixed by squashing each top-level pixi/envs/*
# directory into one .sqfs image (one inode instead of the ~1.1M files they held
# combined -- aviary-13890928915679139205 alone was 874K), leaving an EMPTY
# placeholder directory at each original path. Nothing in those directories is
# readable anymore unless bind-mounted back via apptainer, so every submitted job
# now runs through an apptainer-exec wrapper that mounts all 5 images at their
# original paths before invoking the real jobscript -- transparent to whatever
# `pixi run --manifest-path ... -e <env> ...` the jobscript itself calls, since
# each env resolves to its normal absolute path either way. Verified end-to-end
# (rigorous negative-control tests -- empty placeholder + bind + read + confirm
# host stays empty after -- for every image, plus a real PBS job running `pixi run
# -e checkm2 checkm2 --help` through all 5 binds simultaneously) before wiring in.
APPTAINER_BIN = "/opt/nci/apptainer/bin/apptainer"
APPTAINER_BASE_SIF = "/home/586/sa4958/deepocean_scripts/sqfs_base/ubuntu.sif"
PIXI_SQFS_DIR = "/scratch/zh61/sa4958/pixi/sqfs"
PIXI_ENVS_DIR = "/scratch/zh61/sa4958/pixi/envs"
PIXI_SQFS_ENVS = [
    "aviary-13890928915679139205",
    "binchicken-16235779617320621780",
    "DeepOceanGenomes-9637173285384759191",
    "BinChicken-5222337612630778772",
