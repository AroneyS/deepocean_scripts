# which set the snakemake rule's `resources: gpus = N`) are routed to gpuvolta
# instead of whatever queue the profile passes via -q. NCI's gpuvolta queue is
# allocated in fixed units of 12 cpus + ~95GB mem per GPU, so ncpus/mem are
# overridden to that ratio rather than trusting the rule's CPU-mode thread/mem
# request.
GPU_QUEUE = "gpuvolta"
